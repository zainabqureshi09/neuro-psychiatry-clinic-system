# Environment Configuration Template for Psychiatry EMR System
# Do NOT put real secrets in this file. Copy to .env.local for local development.

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/psychiatrist_emr

# JWT and Session Security (Use a strong 32+ character secret in production)
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters_here
SESSION_SECRET=your_secure_session_secret_key_minimum_32_characters_here

# Backend Express Server Port
PORT=5000

# Application Environment (development, test, or production)
NODE_ENV=development

# Frontend API URL Configuration (Used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Allowed Frontend Origins for Production CORS (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Initial Production Admin Account Bootstrap Credentials (Used only on first startup if database is empty)
INITIAL_ADMIN_EMAIL=admin@yourclinicdomain.com
INITIAL_ADMIN_PASSWORD=your_strong_production_admin_password_here

# Supabase PostgreSQL & Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# PostgreSQL data layer (Phase Three)
# ------------------------------------------------------------------------------
# Provider selection: 'postgres' (Supabase JS client + pg pool) or 'mongodb'
# (preserved legacy implementation). Leave unset for automatic detection:
# PostgreSQL is used when SUPABASE_URL + SUPABASE_SECRET_KEY are configured.
# DB_PROVIDER=postgres

# Optional direct PostgreSQL connection string used ONLY for atomic transactions
# (payments, appointment booking, consultation cascades). Requires the Supabase
# pooler host, e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Set to 'true' only when you intentionally want to skip the DNS pre-flight check
# for the Supabase host before a live connection attempt.
# DB_SKIP_REACHABILITY_CHECK=false


