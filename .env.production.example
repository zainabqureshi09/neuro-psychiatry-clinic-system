# ==============================================================================
# Production Environment Configuration - NPCS Psychiatry EMR
# Copy this file to .env.production on the production VPS (chmod 600)
# CAUTION: NEVER commit .env.production or real secrets to source control!
# ==============================================================================

# 1. Server Runtime Environment
NODE_ENV=production
HOST=127.0.0.1
PORT=5000

# 2. Primary Database Provider (Supabase PostgreSQL + Session Pooler)
DB_PROVIDER=postgres

# Supabase Project URL & API Keys
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL Session Pooler Connection String (Port 5432 REQUIRED for BEGIN/COMMIT transactions)
# IMPORTANT: Always use the IPv4 Session Pooler on port 5432 with sslmode=verify-full.
# NEVER use port 6543 (transaction pooler), which breaks multi-statement SQL transactions.
DATABASE_URL=postgresql://postgres.your-project-id:<YOUR_DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full

# Supabase Root CA Certificate (REQUIRED in production for strict TLS CA + hostname verification)
# Download `prod-ca-2021.crt` from: Supabase Dashboard -> Project Settings -> Database -> SSL Configuration
# Place on VPS at /etc/ssl/certs/prod-ca-2021.crt (chmod 644)
SUPABASE_SSL_CA_PATH=/etc/ssl/certs/prod-ca-2021.crt

# 3. Security Secrets (MUST be unique, random, and 32+ characters long)
# Generate via: openssl rand -hex 32
JWT_SECRET=<GENERATE_A_STRONG_UNIQUE_32_PLUS_CHAR_SECRET>
SESSION_SECRET=<GENERATE_A_STRONG_UNIQUE_32_PLUS_CHAR_SECRET>

# 4. Frontend Public API URL (Used by Next.js client side; routed by Nginx to Express :5000)
NEXT_PUBLIC_API_URL=https://emr.yourclinicdomain.com

# 5. Production CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://emr.yourclinicdomain.com

# 6. Initial Production Admin Bootstrap (Used ONLY on first launch when users table has 0 rows)
# Password MUST be at least 12 characters and not a known placeholder. Remove after initial login.
INITIAL_ADMIN_EMAIL=admin@yourclinicdomain.com
INITIAL_ADMIN_PASSWORD=<GENERATE_A_STRONG_UNIQUE_12_PLUS_CHAR_PASSWORD>

# 7. Legacy MongoDB Fallback (Disabled when DB_PROVIDER=postgres; preserved for reference only)
# MONGODB_URI=mongodb://emr_app_user:<GENERATE_A_STRONG_UNIQUE_PASSWORD>@127.0.0.1:27017/psychiatrist_emr?authSource=psychiatrist_emr
